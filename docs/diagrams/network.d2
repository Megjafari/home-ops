# --- Style classes ---
classes: {
  gateway: {
    style: {
      fill: "#2b6cb0"
      font-color: "#ffffff"
      border-radius: 8
      stroke-width: 2
    }
  }
  segment: {
    style: {
      fill: "#f0f4f8"
      stroke: "#2b6cb0"
      stroke-width: 2
      border-radius: 12
      font-color: "#1a202c"
    }
  }
  node: {
    style: {
      fill: "#ffffff"
      stroke: "#4a5568"
      border-radius: 6
      font-color: "#1a202c"
    }
  }
  infra: {
    style: {
      fill: "#edf2f7"
      stroke: "#718096"
      border-radius: 6
    }
  }
}

title: |md
  # Homelab Network Architecture
  VLAN-segmented network behind OPNsense, September 2026
| {
  near: top-center
  style.font-size: 24
}

WAN: Internet\n(Tele2 modem) {
  shape: cloud
}

OPNsense: OPNsense Router\n(Dell Wyse) {
  class: gateway
  shape: hexagon
}

Zyxel: Zyxel Switch\n(VLAN trunk) {
  class: infra
  shape: rectangle
}

AP: UniFi AP\nAC Long Range {
  class: infra
  shape: rectangle
}

Trusted: {
  class: segment
  label: "VLAN 1 · Trusted\n192.168.1.0/24"
  laptop: My devices {class: node}
}

Kluster: {
  class: segment
  label: "VLAN 10 · Kluster\n192.168.1.0/24"
  nuke: nuke\n(control plane) {class: node}
  tank: nas/tank\n(NAS + GPU) {class: node}
}

IoT: {
  class: segment
  label: "VLAN 20 · IoT\n(planned)"
  devices: Smart home\ndevices {class: node}
}

Guest: {
  class: segment
  label: "VLAN 30 · Guest\n(planned)"
  guests: Guest\ndevices {class: node}
}

# --- Connections ---
WAN -> OPNsense: WAN uplink
OPNsense -> Zyxel: tagged trunk\n(all VLANs)

Zyxel -> Trusted: untagged\naccess port
Zyxel -> Kluster: untagged\naccess port
Zyxel -> AP: tagged trunk\n(IoT + Guest SSIDs)

AP -> IoT: SSID "Home-IoT"
AP -> Guest: SSID "Home-Guest"

# --- Firewall notes ---
OPNsense -> IoT: "\nfirewall: internet-only,\nno LAN access" {
  style.stroke-dash: 4
  style.stroke: "#e53e3e"
}
OPNsense -> Guest: "\nfirewall: internet-only,\nisolated" {
  style.stroke-dash: 4
  style.stroke: "#e53e3e"
}
